# Copy to `.env.local` for local dev overrides (never commit real .env files).
# Base URL of the Django API. Leave empty to use the Vite dev proxy (see
# vite.config.ts `server.proxy['/api']`) which forwards to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=

# Only read by vite.config.ts (Node context), forwards `/api` calls in dev.
VITE_API_PROXY_TARGET=http://localhost:8000
