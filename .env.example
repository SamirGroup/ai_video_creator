# ============================================================================
# AI YouTube Content Ecosystem — environment variables (docker-compose)
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# In CI/production, these are injected via GitHub Actions / VPS secrets —
# never hardcoded in the repo (see .github/workflows/ci.yml and deploy/deploy.sh).
# ============================================================================

# ---- PostgreSQL (service: db) ----
POSTGRES_DB=ai_youtuber
POSTGRES_USER=ai_youtuber
POSTGRES_PASSWORD=changeme
# Convenience DSN some Django setups read directly (dj-database-url style).
# Host is the compose service name, not localhost.
DATABASE_URL=postgres://ai_youtuber:changeme@db:5432/ai_youtuber

# ---- Redis (service: redis) — Celery broker/result backend, cache, throttling ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Django (service: backend / celery_worker / celery_beat) ----
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend (service: frontend) ----
# Base URL the React app uses to call the Django API.
VITE_API_BASE_URL=http://localhost:8000

# ---- (Optional, dev) MinIO — see commented `minio` service in docker-compose.yml ----
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# ---- Everything below is a PLACEHOLDER only — set real values via your
# secret manager / CI secrets in staging & prod, never in this file. ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# SENTRY_DSN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODERATION_API_KEY=
# ELEVENLABS_API_KEY=
# RUNWAY_API_KEY=
# TOKEN_ENCRYPTION_KEY=
