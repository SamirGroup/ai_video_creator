# Copy to `.env` and fill in real values. NEVER commit `.env` with real secrets.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=changeme-generate-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgres://ai_youtuber:ai_youtuber@localhost:5432/ai_youtuber

# --- Redis (Celery broker/backend + cache) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (used to build links in transactional emails) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- JWT (djangorestframework-simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
JWT_SIGNING_KEY=changeme-generate-a-separate-long-random-value

# --- Field-level AES encryption (OAuth tokens, TOTP secrets) ---
# Fernet key(s), base64 urlsafe 32-byte. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Format: "<version>:<key>,<version>:<key>,..." — first entry is the active write key.
FIELD_ENCRYPTION_KEYS=1:changeme-generate-a-fernet-key
FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=1

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_PUBLISHABLE_KEY=pk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# --- Google OAuth (login + YouTube + AdSense) ---
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=changeme
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/youtube/callback
GOOGLE_ADSENSE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/adsense/callback

# --- AI providers (per SPEC 9-bo'lim / api_credentials_config) ---
# These names are referenced BY NAME from api_credentials_config.secret_ref.
# Which provider/model is used is a DB row (admin -> providers), not a setting.

# Script generation (stage 1) — OpenRouter, model configured in the DB
# (seeded: anthropic/claude-sonnet-4.5). https://openrouter.ai/keys
OPENROUTER_API_KEY=changeme
# Optional OpenRouter attribution headers + endpoint override.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_APP_URL=https://your-domain.example
# OPENROUTER_APP_TITLE=AI YouTube Content Ecosystem

# Script moderation gate (stage 2, FR-45) — OpenAI Moderation API.
# OPENAI_MODERATION_API_KEY lets the gate be rotated/rate-limited separately;
# if it is empty, the code falls back to OPENAI_API_KEY.
OPENAI_API_KEY=changeme
OPENAI_MODERATION_API_KEY=

ELEVENLABS_API_KEY=changeme
RUNWAY_API_KEY=changeme
AWS_REKOGNITION_ACCESS_KEY_ID=changeme
AWS_REKOGNITION_SECRET_ACCESS_KEY=changeme

# --- Script stage tuning (optional; api_credentials_config.config wins) ---
# SCRIPT_LLM_TIMEOUT_SEC=120
# SCRIPT_LLM_MAX_OUTPUT_TOKENS=4000
# SCRIPT_LLM_TEMPERATURE=0.8
# FR-37: how many previous titles are injected as "do not repeat" context.
# SCRIPT_RECENT_TOPICS_LIMIT=20
# SCRIPT_TITLE_SIMILARITY_THRESHOLD=0.9
# SCRIPT_MAX_DEDUP_ATTEMPTS=2
# FR-52: per-job provider spend ceiling in USD.
# JOB_COST_CEILING_USD=5.00

# --- Moderation thresholds (FR-45, FR-48) ---
# MODERATION_BLOCK_THRESHOLD=0.5
# MODERATION_FLAG_THRESHOLD=0.2
# FR-48 default: a blocked script goes to the human moderator queue, never to
# an automatic reject. Set to True only if you want hard auto-reject.
# MODERATION_AUTO_REJECT_ON_BLOCK=False

# --- S3 / object storage (media, video assets) ---
AWS_STORAGE_ACCESS_KEY_ID=changeme
AWS_STORAGE_SECRET_ACCESS_KEY=changeme
AWS_STORAGE_BUCKET_NAME=ai-youtuber-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# --- Email (transactional) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=changeme
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=development

# --- Storage / media (core.storage) ---
# Leave AWS_STORAGE_BUCKET_NAME empty to use LocalFileStorage (dev/tests); signed
# local media URLs are served from BACKEND_BASE_URL/internal/media/.
LOCAL_MEDIA_ROOT=
BACKEND_BASE_URL=http://localhost:8000
SIGNED_URL_TTL_SEC=86400

# --- AWS Rekognition (FR-46 final visual moderation) ---
AWS_REKOGNITION_ACCESS_KEY_ID=changeme
AWS_REKOGNITION_SECRET_ACCESS_KEY=changeme
AWS_REKOGNITION_REGION=us-east-1

# --- FFmpeg (FR-50 assembly) — binaries on PATH or absolute paths ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
